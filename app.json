{
  "expo": {
    "name": "Drogaria Rocha",
    "slug": "drogaria-rocha",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "primaryColor": "#F47A1F",
    "scheme": "drogariarocha",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita acesso às fotos para cadastrar imagens dos produtos da Drogaria Rocha.",
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "com.ativadigitalon.drogariarocha",
      "versionCode": 4,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F47A1F"
      }
    },
    "ios": {
      "bundleIdentifier": "com.ativadigitalon.drogariarocha",
      "buildNumber": "1.0.3",
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "1136251a-1bad-414b-a8ef-803462164948"
      }
    }
  }
}
